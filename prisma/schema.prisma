generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id          String   @id @default(uuid())
  code        String   @unique
  targetUrl   String
  clicks      Int      @default(0)
  lastClicked DateTime?
  createdAt   DateTime @default(now())
  events      ClickEvent[]
}

model ClickEvent {
  id        String   @id @default(uuid())
  link      Link     @relation(fields: [linkId], references: [id])
  linkId    String
  createdAt DateTime @default(now())
}
